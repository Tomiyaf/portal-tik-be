@baseUrl = http://localhost:8000
@token = 1|OFZTOMAEppQ8OGYdJWDtPPskuUHqcLj9KZzBq9PY3af59ef1
@auth = Authorization: Bearer {{token}}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin123"
}

### Get User Profile
GET {{baseUrl}}/api/profile
Authorization: Bearer {{token}}
Accept: application/json

### Update User Profile
PATCH {{baseUrl}}/api/profile
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "password": "admin1"
}

### Open Gate
POST {{baseUrl}}/api/gate/open
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "gate_id": 1,
    "access_method": "mobile_app",
    "notes": "Testing open gate"
}

### Close Gate
POST {{baseUrl}}/api/gate/close
{{auth}}